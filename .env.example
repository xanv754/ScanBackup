# Copy to .env before running `docker compose up`.

# Root credentials used only to bootstrap the MongoDB container (enables --auth).
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me

# Application-level DB user, created on first boot by mongo-init/init-mongo.js.
# Must match the `database:` block in DataBackup/config.docker.yml.
MONGO_APP_DB=scanbackup_db
MONGO_APP_USER=scanner
MONGO_APP_PASSWORD=change-me
